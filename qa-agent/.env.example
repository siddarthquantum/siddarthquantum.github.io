# Copy this file to .env and fill in. Never commit .env.
GOOGLE_API_KEY=paste-your-ai-studio-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Pick a Flash model ID shown in Google AI Studio's model list
QA_MODEL=
# Which app profile to load from profiles/: apidemos or client
QA_PROFILE=apidemos
APPIUM_URL=http://127.0.0.1:4723
DEVICE_NAME=emulator-5554
STEP_LIMIT=25
# reset_app restarts the app and clears its data (clean state per test). false = keep data.
RESET_CLEAR_DATA=true
# Fast demo mode: click-only (no typing), max screens to explore, max test cases
QA_CLICK_ONLY=true
QA_MAX_SCREENS=3
QA_MAX_TESTS=4
QA_MIN_TURN_SECONDS=4
